# Fill these in using the hosting provider's private environment-variable editor.
# Actual .env files are excluded from source control.
PUBLIC_BASE_URL=https://connector.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_GOOGLE_EMAIL=owner@example.com
TOKEN_ENCRYPTION_KEY=
JWT_SIGNING_KEY=
# Mount a persistent volume at /data, writable by container UID 10001.
TOKEN_STORE_DIR=/data/oauth
PORT=8000
# Optional Meta reporting, restricted to this one ad account. Set both together.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=v26.0
